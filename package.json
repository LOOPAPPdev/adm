{
  "name": "adm",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo ADM: diretório unificado de Skills, Agents, Plugins e MCP Servers (fonte inicial: Anthropic Directory)",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "sync": "npm run sync -w @adm/orchestrator",
    "sync:offline": "npm run sync -w @adm/orchestrator --",
    "orchestrator": "npm run cli -w @adm/orchestrator --",
    "test": "npm test -w @adm/orchestrator",
    "dev": "npm run dev -w @adm/web",
    "build": "npm run build -w @adm/web",
    "deploy": "npm run deploy -w @adm/web"
  }
}
