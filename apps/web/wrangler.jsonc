/**
 * LOOP unified application: one Worker ("adm", the name Workers Builds expects) serves the website, Workspace, Studio, Portal, ADM Directory and /api/v1.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Before the first deploy (see docs/deployment/DEPLOY_MEMORY.md):
 *   npx wrangler d1 create loop-db            → copy the database_id below
 *   npx wrangler d1 migrations apply loop-db --remote
 *   npx wrangler secret put BOOTSTRAP_TOKEN    → only to create the first admin, then delete it
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adm",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "loop-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
