{
  "name": "@adm/loop",
  "private": true,
  "version": "1.0.0",
  "description": "LOOP v1.0 — site da consultoria, Workspace do Consultor, LOOP Studio e Portal do Cliente (front-end funcional, sem backend).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "zip": "node scripts/zip.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name loop-app"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "bpmn-moddle": "10.3.1",
    "fake-indexeddb": "6.2.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@xyflow/react": "12.12.1",
    "bpmn-js": "18.31.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "elkjs": "0.12.1",
    "lucide-react": "1.71.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  }
}
